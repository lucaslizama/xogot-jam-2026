; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pizza Flicker"
config/version="0.29.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1170
window/size/viewport_height=2532
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/size/mode.editor=2
window/stretch/aspect.web="keep"
window/stretch/aspect.editor="keep"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/canvas_textures/default_texture_filter=2
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_2d=2

[xogot]

project/editorState=[{
"column": 0,
"line": 0,
"path": "res://scripts/pizza/rules/pizza_physics.gd",
"type": "file"
}, {
"column": 0,
"line": 0,
"path": "res://scenes/ui/result_card.tscn",
"type": "file"
}, {
"column": 0,
"current": true,
"line": 0,
"path": "res://scripts/pizza/ui/result_card.gd",
"type": "file"
}]
project/shaderEditorState=[]
project/breakpoints={}
project/disabled_breakpoints={}
