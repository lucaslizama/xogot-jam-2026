note = "A finger dragging back off the pizza and letting go, the box flying up the street"
diagram = 1
caption = "Drag the pizza and let go. The faster your flick, the further it flies."

[node name="Curve" parent="Scroll/Steps" instance=ExtResource("2_step")]
layout_mode = 2
picture_height = 700.0
note = "The pizza being twisted in the hand, then thrown, the flight bending sideways"
diagram = 2
caption = "Twist the pizza before you throw and it curves in the air. That is how you reach a house off to one side."

[node name="Land" parent="Scroll/Steps" instance=ExtResource("2_step")]
layout_mode = 2
picture_height = 700.0
note = "A pizza dropping into the ring in front of a lit house, and a second one hitting the wall"
diagram = 3
caption = "Hit a house that is waiting, or land in the ring at its feet. Either one counts. Miss both and you lose a strike. Straight through the lit window pays best of all."

[node name="Stack" parent="Scroll/Steps" instance=ExtResource("2_step")]
layout_mode = 2
picture_height = 560.0
note = "The stack of boxes on the bike shrinking as pizzas are thrown, and the strike dots along the top"
diagram = 4
caption = "The boxes on the bike are the pizzas you have left. Empty the stack with a strike to spare and you win the street."

